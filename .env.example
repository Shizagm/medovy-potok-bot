# Скопируйте этот файл в .env. Не публикуйте .env.
BOT_TOKEN=
# Числовой Telegram ID мастера; несколько ID через запятую
ADMIN_IDS=
# Отрицательный ID отдельной закрытой группы
TAVERN_CHAT_ID=
# ID темы для рейтингов и публичных сообщений внутри закрытой группы; 0 — общий чат
PUBLIC_TOPIC_ID=0
DB_PATH=data/tavern.sqlite3
BACKUP_DIR=data/backups
